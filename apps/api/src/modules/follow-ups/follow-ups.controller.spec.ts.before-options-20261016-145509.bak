
import { beforeEach, describe, expect, it, vi } from 'vitest';

import {
  RequestMethod,
} from '@nestjs/common';

import {
  METHOD_METADATA,
  PATH_METADATA,
} from '@nestjs/common/constants';

import {
  PERMISSIONS_KEY,
} from '../auth/decorators/permissions.decorator.js';

import { FollowUpsController } from './follow-ups.controller.js';
import { FollowUpsService } from './follow-ups.service.js';

describe('FollowUpsController', () => {
  let controller: FollowUpsController;

  const followUpsServiceMock = {
    create: vi.fn(),
    findMine: vi.fn(),
    findMyOverdue: vi.fn(),
    summary: vi.fn(),
    findAllScoped: vi.fn(),
    findOne: vi.fn(),
    update: vi.fn(),
    updateStatus: vi.fn(),
    reassign: vi.fn(),
  };

  beforeEach(() => {
    vi.resetAllMocks();

    controller = new FollowUpsController(
      followUpsServiceMock as unknown as FollowUpsService,
    );
  });

  it('should be defined', () => {
    expect(controller).toBeDefined();
  });

  it('creates a follow-up for the current user', async () => {
    const dto = {} as Parameters<FollowUpsController['create']>[0];
    const user = {} as Parameters<FollowUpsController['create']>[1];
    const expected = { id: 'follow-up-1' };

    followUpsServiceMock.create.mockResolvedValue(expected);

    const result = await controller.create(dto, user);

    expect(followUpsServiceMock.create).toHaveBeenCalledWith(dto, user);
    expect(result).toEqual(expected);
  });

  it('returns follow-ups belonging to the current user', async () => {
    const user = {} as Parameters<FollowUpsController['findMine']>[0];
    const expected = [{ id: 'follow-up-1' }];

    followUpsServiceMock.findMine.mockResolvedValue(expected);

    const result = await controller.findMine(user);

    expect(followUpsServiceMock.findMine).toHaveBeenCalledWith(user);
    expect(result).toEqual(expected);
  });

  it('returns overdue follow-ups for the current user', async () => {
    const user = {} as Parameters<FollowUpsController['findMyOverdue']>[0];
    const expected = [{ id: 'follow-up-1', overdue: true }];

    followUpsServiceMock.findMyOverdue.mockResolvedValue(expected);

    const result = await controller.findMyOverdue(user);

    expect(followUpsServiceMock.findMyOverdue).toHaveBeenCalledWith(user);
    expect(result).toEqual(expected);
  });

  it('returns follow-up summary for the current user', async () => {
    const user = {} as Parameters<FollowUpsController['summary']>[0];
    const expected = { total: 10, overdue: 2 };

    followUpsServiceMock.summary.mockResolvedValue(expected);

    const result = await controller.summary(user);

    expect(followUpsServiceMock.summary).toHaveBeenCalledWith(user);
    expect(result).toEqual(expected);
  });

  it('returns follow-ups within the current user scope', async () => {
    const user = {} as Parameters<FollowUpsController['findAll']>[0];
    const expected = [{ id: 'follow-up-1' }];

    followUpsServiceMock.findAllScoped.mockResolvedValue(expected);

    const result = await controller.findAll(user);

    expect(followUpsServiceMock.findAllScoped).toHaveBeenCalledWith(user);
    expect(result).toEqual(expected);
  });

  it('returns a follow-up by ID', async () => {
    const user = {} as Parameters<FollowUpsController['findOne']>[1];
    const expected = { id: 'follow-up-1' };

    followUpsServiceMock.findOne.mockResolvedValue(expected);

    const result = await controller.findOne('follow-up-1', user);

    expect(followUpsServiceMock.findOne).toHaveBeenCalledWith(
      'follow-up-1',
      user,
    );
    expect(result).toEqual(expected);
  });

  it('updates a follow-up', async () => {
    const dto = {} as Parameters<FollowUpsController['update']>[1];
    const user = {} as Parameters<FollowUpsController['update']>[2];
    const expected = { id: 'follow-up-1', updated: true };

    followUpsServiceMock.update.mockResolvedValue(expected);

    const result = await controller.update('follow-up-1', dto, user);

    expect(followUpsServiceMock.update).toHaveBeenCalledWith(
      'follow-up-1',
      dto,
      user,
    );
    expect(result).toEqual(expected);
  });

  it('protects the reassignment route with its dedicated permission', () => {
    const handler = FollowUpsController.prototype.reassign;

    expect(
      Reflect.getMetadata(PATH_METADATA, handler),
    ).toBe(':id/reassign');

    expect(
      Reflect.getMetadata(METHOD_METADATA, handler),
    ).toBe(RequestMethod.PATCH);

    expect(
      Reflect.getMetadata(PERMISSIONS_KEY, handler),
    ).toEqual(['followup.reassign']);
  });
  it('reassigns a follow-up to another employee', async () => {
    const dto = {
      assignedToUserId: '11111111-1111-4111-8111-111111111111',
    };

    const user = {
      id: 'manager-1',
    } as Parameters<FollowUpsController['reassign']>[2];

    const expected = {
      id: 'follow-up-1',
      assignedToUserId: dto.assignedToUserId,
    };

    followUpsServiceMock.reassign.mockResolvedValue(expected);

    const result = await controller.reassign(
      'follow-up-1',
      dto,
      user,
    );

    expect(followUpsServiceMock.reassign).toHaveBeenCalledOnce();

    expect(followUpsServiceMock.reassign).toHaveBeenCalledWith(
      'follow-up-1',
      dto,
      user,
    );

    expect(result).toEqual(expected);
  });
  it('updates a follow-up status', async () => {
    const dto = {} as Parameters<FollowUpsController['updateStatus']>[1];
    const user = {} as Parameters<FollowUpsController['updateStatus']>[2];
    const expected = { id: 'follow-up-1', status: 'COMPLETED' };

    followUpsServiceMock.updateStatus.mockResolvedValue(expected);

    const result = await controller.updateStatus(
      'follow-up-1',
      dto,
      user,
    );

    expect(followUpsServiceMock.updateStatus).toHaveBeenCalledWith(
      'follow-up-1',
      dto,
      user,
    );
    expect(result).toEqual(expected);
  });
});
