import { beforeEach, describe, expect, it, vi } from 'vitest';

import {
  BadRequestException,
  ForbiddenException,
} from '@nestjs/common';

import { FollowUpsService } from './follow-ups.service.js';

import type { PrismaService } from '../../database/prisma/prisma.service.js';
import type { ScopeService } from '../auth/services/scope.service.js';
import type { AuthenticatedUser } from '../auth/interfaces/authenticated-user.interface.js';

describe('FollowUpsService assignment validation', () => {
  const user = {
    id: 'manager-1',
    username: 'manager',
    firstName: 'Test',
    lastName: 'Manager',
    roles: [],
    permissions: [],
    scopes: [],
    roleAssignments: [],
  } satisfies AuthenticatedUser;

  const followUp = {
    id: 'follow-up-1',
    branchId: 'branch-a',
    assignedToUserId: 'old-staff',
    isEnabled: true,
    deletedAt: null,
  };

  const prismaMock = {
    followUp: {
      findFirst: vi.fn(),
      update: vi.fn(),
    },
    user: {
      findFirst: vi.fn(),
    },
  };

  const scopeMock = {
    assertBranchAccess: vi.fn(),
  };

  let service: FollowUpsService;

  const assignedStaff = (
    status: 'ACTIVE' | 'INACTIVE' = 'ACTIVE',
    branchId = 'branch-a',
  ) => ({
    id: 'new-staff',
    status: 'ACTIVE',
    deletedAt: null,
    staffProfile: {
      status,
      branchId,
    },
  });

  beforeEach(() => {
    vi.resetAllMocks();

    prismaMock.followUp.findFirst.mockResolvedValue(followUp);

    prismaMock.user.findFirst.mockResolvedValue(
      assignedStaff(),
    );

    prismaMock.followUp.update.mockResolvedValue({
      ...followUp,
      assignedToUserId: 'new-staff',
    });

    scopeMock.assertBranchAccess.mockResolvedValue(
      undefined,
    );

    service = new FollowUpsService(
      prismaMock as unknown as PrismaService,
      scopeMock as unknown as ScopeService,
    );
  });

  it('allows an active employee in the same branch', async () => {
    await expect(
      service.update(
        followUp.id,
        { assignedToUserId: 'new-staff' },
        user,
      ),
    ).resolves.toMatchObject({
      assignedToUserId: 'new-staff',
    });

    expect(prismaMock.followUp.update).toHaveBeenCalledOnce();

    expect(scopeMock.assertBranchAccess)
      .toHaveBeenCalledWith(user, 'branch-a');
  });

  it('rejects an inactive employee account', async () => {
    prismaMock.user.findFirst.mockResolvedValue(null);

    await expect(
      service.update(
        followUp.id,
        { assignedToUserId: 'new-staff' },
        user,
      ),
    ).rejects.toThrow(BadRequestException);

    expect(prismaMock.followUp.update).not.toHaveBeenCalled();
  });

  it('rejects an inactive staff profile', async () => {
    prismaMock.user.findFirst.mockResolvedValue(
      assignedStaff('INACTIVE'),
    );

    await expect(
      service.update(
        followUp.id,
        { assignedToUserId: 'new-staff' },
        user,
      ),
    ).rejects.toThrow(BadRequestException);

    expect(prismaMock.followUp.update).not.toHaveBeenCalled();
  });

  it('rejects an employee from another branch', async () => {
    prismaMock.user.findFirst.mockResolvedValue(
      assignedStaff('ACTIVE', 'branch-b'),
    );

    await expect(
      service.update(
        followUp.id,
        { assignedToUserId: 'new-staff' },
        user,
      ),
    ).rejects.toThrow(
      'Assigned user must belong to the follow-up branch',
    );

    expect(prismaMock.followUp.update).not.toHaveBeenCalled();
  });

  it('rejects an employee without a staff profile', async () => {
    prismaMock.user.findFirst.mockResolvedValue({
      id: 'new-staff',
      status: 'ACTIVE',
      deletedAt: null,
      staffProfile: null,
    });

    await expect(
      service.update(
        followUp.id,
        { assignedToUserId: 'new-staff' },
        user,
      ),
    ).rejects.toThrow(BadRequestException);

    expect(prismaMock.followUp.update).not.toHaveBeenCalled();
  });

  it('rejects assignment when branch access is denied', async () => {
    scopeMock.assertBranchAccess.mockRejectedValue(
      new ForbiddenException('Access denied'),
    );

    await expect(
      service.update(
        followUp.id,
        { assignedToUserId: 'new-staff' },
        user,
      ),
    ).rejects.toThrow(ForbiddenException);

    expect(prismaMock.followUp.update).not.toHaveBeenCalled();
  });
});
