import { beforeEach, describe, expect, it, vi } from 'vitest';

import {
  BadRequestException,
  ForbiddenException,
} from '@nestjs/common';

import { FollowUpsService } from './follow-ups.service.js';

import type { PrismaService } from '../../database/prisma/prisma.service.js';
import type { ScopeService } from '../auth/services/scope.service.js';
import type { AuthenticatedUser } from '../auth/interfaces/authenticated-user.interface.js';

describe('FollowUpsService secure reassignment', () => {
  const manager = {
    id: 'manager-1',
    username: 'manager',
    firstName: 'Test',
    lastName: 'Manager',
    roles: [],
    permissions: [],
    scopes: [],
    roleAssignments: [],
  } satisfies AuthenticatedUser;

  const followUp = {
    id: 'follow-up-1',
    branchId: 'branch-a',
    assignedToUserId: 'staff-old',
    isEnabled: true,
    deletedAt: null,
  };

  const branch = {
    id: 'branch-a',
    districtId: 'district-a',
    district: {
      regionId: 'region-a',
    },
  };

  const prismaMock = {
    followUp: {
      findFirst: vi.fn(),
      updateMany: vi.fn(),
      findUniqueOrThrow: vi.fn(),
    },
    userRole: {
      findMany: vi.fn(),
    },
    branch: {
      findFirst: vi.fn(),
    },
    user: {
      findFirst: vi.fn(),
    },
    auditLog: {
      create: vi.fn(),
    },
    $transaction: vi.fn(),
  };

  const scopeMock = {
    assertBranchAccess: vi.fn(),
  };

  let service: FollowUpsService;

  beforeEach(() => {
    vi.resetAllMocks();

    prismaMock.followUp.findFirst.mockResolvedValue(followUp);
    prismaMock.branch.findFirst.mockResolvedValue(branch);
    prismaMock.userRole.findMany.mockResolvedValue([]);

    prismaMock.user.findFirst.mockResolvedValue({
      id: 'staff-new',
    });

    prismaMock.followUp.updateMany.mockResolvedValue({
      count: 1,
    });

    prismaMock.followUp.findUniqueOrThrow.mockResolvedValue({
      ...followUp,
      assignedToUserId: 'staff-new',
    });

    prismaMock.auditLog.create.mockResolvedValue({
      id: 'audit-1',
    });

    prismaMock.$transaction.mockImplementation(
      async (callback: (tx: typeof prismaMock) => Promise<unknown>) =>
        callback(prismaMock),
    );

    service = new FollowUpsService(
      prismaMock as unknown as PrismaService,
      scopeMock as unknown as ScopeService,
    );
  });

  it('successfully reassigns a follow-up', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-a',
        districtId: null,
        regionId: null,
        role: {
          code: 'BRANCH_MANAGER',
        },
      },
    ]);

    const result = await service.reassign(
      followUp.id,
      { assignedToUserId: 'staff-new' },
      manager,
    );

    expect(result.assignedToUserId).toBe('staff-new');

    expect(prismaMock.$transaction).toHaveBeenCalledOnce();

    expect(prismaMock.user.findFirst).toHaveBeenCalledTimes(2);

    expect(prismaMock.followUp.updateMany).toHaveBeenCalledWith({
      where: {
        id: followUp.id,
        branchId: 'branch-a',
        assignedToUserId: 'staff-old',
        deletedAt: null,
        isEnabled: true,
      },
      data: {
        assignedToUserId: 'staff-new',
      },
    });
  });

  it('records the reassignment audit trail', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-a',
        districtId: null,
        regionId: null,
        role: {
          code: 'BRANCH_MANAGER',
        },
      },
    ]);

    await service.reassign(
      followUp.id,
      { assignedToUserId: 'staff-new' },
      manager,
    );

    expect(prismaMock.auditLog.create).toHaveBeenCalledOnce();

    expect(prismaMock.auditLog.create).toHaveBeenCalledWith({
      data: {
        userId: manager.id,
        action: 'ASSIGN',
        module: 'FOLLOW_UPS',
        entityType: 'FollowUp',
        entityId: followUp.id,
        description: 'Follow-up reassigned to another employee',
        oldValue: {
          assignedToUserId: 'staff-old',
        },
        newValue: {
          assignedToUserId: 'staff-new',
        },
      },
    });
  });
  it('rejects reassignment to the current employee', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-a',
        districtId: null,
        regionId: null,
        role: {
          code: 'BRANCH_MANAGER',
        },
      },
    ]);

    await expect(
      service.reassign(
        followUp.id,
        { assignedToUserId: 'staff-old' },
        manager,
      ),
    ).rejects.toThrow(
      'Follow-up is already assigned to this employee',
    );

    expect(prismaMock.user.findFirst).not.toHaveBeenCalled();
    expect(prismaMock.$transaction).not.toHaveBeenCalled();
    expect(prismaMock.followUp.updateMany).not.toHaveBeenCalled();
    expect(prismaMock.auditLog.create).not.toHaveBeenCalled();
  });
  it('rejects an inactive replacement employee', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-a',
        districtId: null,
        regionId: null,
        role: { code: 'BRANCH_MANAGER' },
      },
    ]);

    prismaMock.user.findFirst.mockResolvedValue(null);

    await expect(
      service.reassign(
        followUp.id,
        { assignedToUserId: 'staff-new' },
        manager,
      ),
    ).rejects.toThrow(BadRequestException);

    const query = prismaMock.user.findFirst.mock.calls[0]?.[0];

    expect(query.where.status).toBe('ACTIVE');
    expect(query.where.deletedAt).toBeNull();

    expect(prismaMock.$transaction).not.toHaveBeenCalled();
    expect(prismaMock.followUp.updateMany).not.toHaveBeenCalled();
  });

  it('rejects a replacement employee from another branch', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-a',
        districtId: null,
        regionId: null,
        role: { code: 'BRANCH_MANAGER' },
      },
    ]);

    prismaMock.user.findFirst.mockResolvedValue(null);

    await expect(
      service.reassign(
        followUp.id,
        { assignedToUserId: 'staff-new' },
        manager,
      ),
    ).rejects.toThrow(BadRequestException);

    const query = prismaMock.user.findFirst.mock.calls[0]?.[0];

    expect(query.where.staffProfile.is.branchId).toBe('branch-a');

    expect(prismaMock.$transaction).not.toHaveBeenCalled();
    expect(prismaMock.followUp.updateMany).not.toHaveBeenCalled();
  });

  it('rejects an employee who becomes ineligible before the update', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-a',
        districtId: null,
        regionId: null,
        role: { code: 'BRANCH_MANAGER' },
      },
    ]);

    prismaMock.user.findFirst
      .mockResolvedValueOnce({ id: 'staff-new' })
      .mockResolvedValueOnce(null);

    await expect(
      service.reassign(
        followUp.id,
        { assignedToUserId: 'staff-new' },
        manager,
      ),
    ).rejects.toThrow(
      'Replacement employee is no longer eligible',
    );

    expect(prismaMock.user.findFirst).toHaveBeenCalledTimes(2);
    expect(prismaMock.followUp.updateMany).not.toHaveBeenCalled();
    expect(prismaMock.auditLog.create).not.toHaveBeenCalled();
  });
  it('rejects a conflicting reassignment', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-a',
        districtId: null,
        regionId: null,
        role: {
          code: 'BRANCH_MANAGER',
        },
      },
    ]);

    prismaMock.followUp.updateMany.mockResolvedValue({
      count: 0,
    });

    await expect(
      service.reassign(
        followUp.id,
        { assignedToUserId: 'staff-new' },
        manager,
      ),
    ).rejects.toThrow(
      'Follow-up assignment changed. Refresh and try again.',
    );

    expect(prismaMock.$transaction).toHaveBeenCalledOnce();

    expect(prismaMock.followUp.updateMany).toHaveBeenCalledWith({
      where: {
        id: followUp.id,
        branchId: 'branch-a',
        assignedToUserId: 'staff-old',
        deletedAt: null,
        isEnabled: true,
      },
      data: {
        assignedToUserId: 'staff-new',
      },
    });

    expect(prismaMock.followUp.findUniqueOrThrow)
      .not.toHaveBeenCalled();

    expect(prismaMock.auditLog.create)
      .not.toHaveBeenCalled();
  });
  it('rejects reassignment when audit logging fails', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-a',
        districtId: null,
        regionId: null,
        role: {
          code: 'BRANCH_MANAGER',
        },
      },
    ]);

    prismaMock.auditLog.create.mockRejectedValue(
      new Error('Audit write failed'),
    );

    await expect(
      service.reassign(
        followUp.id,
        { assignedToUserId: 'staff-new' },
        manager,
      ),
    ).rejects.toThrow('Audit write failed');

    expect(prismaMock.$transaction).toHaveBeenCalledOnce();

    expect(prismaMock.followUp.updateMany).toHaveBeenCalledOnce();

    expect(prismaMock.auditLog.create).toHaveBeenCalledOnce();

    expect(prismaMock.followUp.updateMany.mock.invocationCallOrder[0])
      .toBeLessThan(
        prismaMock.auditLog.create.mock.invocationCallOrder[0],
      );
  });
  it('rejects missing reassignment permission', async () => {
    await expect(
      service.reassign(
        followUp.id,
        { assignedToUserId: 'staff-new' },
        manager,
      ),
    ).rejects.toThrow(ForbiddenException);

    const query = prismaMock.userRole.findMany.mock.calls[0]?.[0];

    expect(query.where.role.rolePermissions.some.permission).toEqual({
      code: 'followup.reassign',
      status: 'ACTIVE',
    });

    expect(prismaMock.followUp.updateMany).not.toHaveBeenCalled();
  });

  it('rejects reassignment outside the manager branch', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-b',
        districtId: null,
        regionId: null,
        role: {
          code: 'BRANCH_MANAGER',
        },
      },
    ]);

    await expect(
      service.reassign(
        followUp.id,
        { assignedToUserId: 'staff-new' },
        manager,
      ),
    ).rejects.toThrow(ForbiddenException);

    expect(prismaMock.followUp.updateMany).not.toHaveBeenCalled();
  });

  it('rejects reassignment of a disabled follow-up', async () => {
    prismaMock.userRole.findMany.mockResolvedValue([
      {
        scopeType: 'BRANCH',
        branchId: 'branch-a',
        districtId: null,
        regionId: null,
        role: {
          code: 'BRANCH_MANAGER',
        },
      },
    ]);

    prismaMock.followUp.findFirst.mockResolvedValue({
      ...followUp,
      isEnabled: false,
    });

    await expect(
      service.reassign(
        followUp.id,
        { assignedToUserId: 'staff-new' },
        manager,
      ),
    ).rejects.toThrow(BadRequestException);

    expect(prismaMock.user.findFirst).not.toHaveBeenCalled();
    expect(prismaMock.followUp.updateMany).not.toHaveBeenCalled();
  });
});
