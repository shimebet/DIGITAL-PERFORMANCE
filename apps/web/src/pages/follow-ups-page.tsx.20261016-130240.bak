import { useMemo, useState } from "react";

import axios from "axios";

import {
  Alert,
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogContentText,
  DialogTitle,
  FormControl,
  InputLabel,
  MenuItem,
  Select,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Typography,
} from "@mui/material";

import { RefreshOutlined } from "@mui/icons-material";

import {
  useMutation,
  useQuery,
  useQueryClient,
} from "@tanstack/react-query";

import { AddOutlined, EditOutlined, DeleteOutlined, BlockOutlined, CheckCircleOutlined } from "@mui/icons-material";

import { useAuthStore } from "../stores/auth.store";

import { FollowUpCreateDialog } from "../components/follow-ups/follow-up-create-dialog";
import { FollowUpEditDialog } from "../components/follow-ups/follow-up-edit-dialog";

import {
  createFollowUpApi,
  getFollowUpsApi,
  getFollowUpSummaryApi,
  updateFollowUpApi,
  enableFollowUpApi,
  disableFollowUpApi,
  deleteFollowUpApi,
} from "../api/follow-ups.api";

import type {
  CreateFollowUpRequest,
  UpdateFollowUpRequest,
} from "../types/follow-up.types";

import type {
  FollowUp,
  FollowUpPriority,
  FollowUpStatus,
} from "../types/follow-up.types";

const statuses: Array<FollowUpStatus | "ALL"> = [
  "ALL",
  "OPEN",
  "CONTACTED",
  "RESCHEDULED",
  "CONVERTED",
  "NOT_INTERESTED",
  "UNREACHABLE",
  "CLOSED",
];

const priorities: Array<FollowUpPriority | "ALL"> = [
  "ALL",
  "LOW",
  "MEDIUM",
  "HIGH",
  "URGENT",
];

function readable(value: string) {
  return value.replaceAll("_", " ");
}

function displayDate(value: string | null | undefined) {
  if (!value) return "N/A";

  const date = value.slice(0, 10);

  return /^\d{4}-\d{2}-\d{2}$/.test(date)
    ? date
    : "N/A";
}

function userName(
  user: FollowUp["assignedTo"],
  fallbackId: string,
) {
  if (!user) return fallbackId;

  const name = [user.firstName, user.lastName]
    .filter(Boolean)
    .join(" ")
    .trim();

  return name || user.username;
}

function getErrorMessage(error: unknown) {
  if (axios.isAxiosError(error)) {
    const message = error.response?.data?.message;

    if (Array.isArray(message)) {
      return message.join(", ");
    }

    if (typeof message === "string") {
      return message;
    }

    return error.message;
  }

  return error instanceof Error
    ? error.message
    : "Unable to load follow-ups.";
}

function statusColor(status: FollowUpStatus) {
  switch (status) {
    case "CONVERTED":
      return "success" as const;
    case "CLOSED":
      return "default" as const;
    case "NOT_INTERESTED":
      return "error" as const;
    case "UNREACHABLE":
      return "warning" as const;
    case "RESCHEDULED":
      return "info" as const;
    case "CONTACTED":
      return "primary" as const;
    default:
      return "warning" as const;
  }
}

function priorityColor(priority: FollowUpPriority) {
  switch (priority) {
    case "URGENT":
      return "error" as const;
    case "HIGH":
      return "warning" as const;
    case "MEDIUM":
      return "info" as const;
    default:
      return "default" as const;
  }
}

export function FollowUpsPage() {
  const queryClient = useQueryClient();

  const hasPermission = useAuthStore(
    (state) => state.hasPermission,
  );

  const canCreate = hasPermission("followup.create");
  const canUpdate = hasPermission("followup.update");
  const canManage = hasPermission("followup.manage");
  const canDelete = hasPermission("followup.delete");

  const [lifecycleTarget, setLifecycleTarget] = useState<{
    followUp: FollowUp;
    action: "enable" | "disable" | "delete";
  } | null>(null);

  const [lifecycleError, setLifecycleError] = useState<string | null>(null);

  const lifecycleMutation = useMutation({
    mutationFn: async ({
      id,
      action,
    }: {
      id: string;
      action: "enable" | "disable" | "delete";
    }) => {
      if (action === "enable") return enableFollowUpApi(id);
      if (action === "disable") return disableFollowUpApi(id);
      return deleteFollowUpApi(id);
    },
    onSuccess: async () => {
      await queryClient.invalidateQueries({
        queryKey: ["follow-ups"],
      });
    },
  });

  async function confirmLifecycleAction() {
    if (!lifecycleTarget || lifecycleMutation.isPending) return;

    setLifecycleError(null);

    try {
      const { followUp, action } = lifecycleTarget;

      await lifecycleMutation.mutateAsync({
        id: followUp.id,
        action,
      });

      setLifecycleTarget(null);
      setSuccessMessage(
        action === "enable"
          ? "Follow-up enabled successfully."
          : action === "disable"
            ? "Follow-up disabled successfully."
            : "Follow-up deleted successfully.",
      );
    } catch (error) {
      setLifecycleError(getErrorMessage(error));
    }
  }

  const [createOpen, setCreateOpen] = useState(false);
  const [successMessage, setSuccessMessage] = useState<string | null>(null);

  const createMutation = useMutation({
    mutationFn: createFollowUpApi,
    onSuccess: async () => {
      await queryClient.invalidateQueries({
        queryKey: ["follow-ups"],
      });
    },
  });

  async function handleCreate(payload: CreateFollowUpRequest) {
    await createMutation.mutateAsync(payload);

    setCreateOpen(false);
    setSuccessMessage("Follow-up created successfully.");
  }

  const [editingFollowUp, setEditingFollowUp] =
    useState<FollowUp | null>(null);

  const editMutation = useMutation({
    mutationFn: ({
      id,
      payload,
    }: {
      id: string;
      payload: UpdateFollowUpRequest;
    }) => updateFollowUpApi(id, payload),

    onSuccess: async () => {
      await queryClient.invalidateQueries({
        queryKey: ["follow-ups"],
      });
    },
  });

  async function handleEdit(
    id: string,
    payload: UpdateFollowUpRequest,
  ) {
    await editMutation.mutateAsync({ id, payload });

    setEditingFollowUp(null);
    setSuccessMessage("Follow-up updated successfully.");
  }

  const [search, setSearch] = useState("");
  const [status, setStatus] =
    useState<FollowUpStatus | "ALL">("ALL");
  const [priority, setPriority] =
    useState<FollowUpPriority | "ALL">("ALL");

  const recordsQuery = useQuery({
    queryKey: ["follow-ups", "all"],
    queryFn: getFollowUpsApi,
  });

  const summaryQuery = useQuery({
    queryKey: ["follow-ups", "summary"],
    queryFn: getFollowUpSummaryApi,
  });

  const filteredRecords = useMemo(() => {
    const records = recordsQuery.data ?? [];
    const term = search.trim().toLowerCase();

    return records.filter((item) => {
      if (status !== "ALL" && item.status !== status) {
        return false;
      }

      if (
        priority !== "ALL" &&
        item.priority !== priority
      ) {
        return false;
      }

      if (!term) return true;

      const searchable = [
        item.customerReference,
        item.customerNameMasked,
        item.product?.name,
        item.branch?.name,
        item.assignedTo?.username,
        item.assignedTo?.firstName,
        item.assignedTo?.lastName,
        item.reason,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      return searchable.includes(term);
    });
  }, [recordsQuery.data, search, status, priority]);

  const summary = summaryQuery.data;

  const cards = [
    { label: "Total", value: summary?.total },
    { label: "Open", value: summary?.open },
    { label: "Contacted", value: summary?.contacted },
    { label: "Rescheduled", value: summary?.rescheduled },
    { label: "Converted", value: summary?.converted },
    { label: "Overdue", value: summary?.overdue },
  ];

  const refresh = () => {
    void recordsQuery.refetch();
    void summaryQuery.refetch();
  };

  return (
    <Box sx={{ p: { xs: 2, md: 3 } }}>
      <Stack
        direction={{ xs: "column", sm: "row" }}
        spacing={2}
        sx={{
          mb: 3,
          justifyContent: "space-between",
          alignItems: { xs: "stretch", sm: "center" },
        }}
      >
        <Box>
          <Typography variant="h4" sx={{ fontWeight: 700 }}>
            Follow-ups
          </Typography>

          <Typography color="text.secondary">
            Monitor customer follow-ups, assigned staff,
            outcomes, and overdue actions.
          </Typography>
        </Box>

        <Stack direction="row" spacing={1}>
          {canCreate && (
            <Button
              variant="contained"
              startIcon={<AddOutlined />}
              onClick={() => {
                setSuccessMessage(null);
                setCreateOpen(true);
              }}
            >
              Create Follow-up
            </Button>
          )}

        <Button
          variant="outlined"
          startIcon={<RefreshOutlined />}
          onClick={refresh}
          disabled={
            recordsQuery.isFetching ||
            summaryQuery.isFetching
          }
        >
          Refresh
        </Button>
        </Stack>
      </Stack>

      {successMessage && (
        <Alert severity="success" sx={{ mb: 2 }}>
          {successMessage}
        </Alert>
      )}

      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: {
            xs: "repeat(2, minmax(0, 1fr))",
            md: "repeat(3, minmax(0, 1fr))",
            xl: "repeat(6, minmax(0, 1fr))",
          },
          gap: 2,
          mb: 3,
        }}
      >
        {cards.map((card) => (
          <Card key={card.label} variant="outlined">
            <CardContent>
              <Typography
                variant="body2"
                color="text.secondary"
              >
                {card.label}
              </Typography>

              <Typography
                variant="h4"
                sx={{ mt: 1, fontWeight: 700 }}
              >
                {card.value ?? "N/A"}
              </Typography>
            </CardContent>
          </Card>
        ))}
      </Box>

      {summaryQuery.isError && (
        <Alert severity="warning" sx={{ mb: 2 }}>
          Summary could not be loaded:{" "}
          {getErrorMessage(summaryQuery.error)}
        </Alert>
      )}

      <Card variant="outlined">
        <CardContent>
          <Stack
            direction={{ xs: "column", md: "row" }}
            spacing={2}
            sx={{ mb: 3 }}
          >
            <TextField
              label="Search follow-ups"
              placeholder="Customer, product, branch, staff..."
              size="small"
              value={search}
              onChange={(event) =>
                setSearch(event.target.value)
              }
              sx={{ flex: 1 }}
            />

            <FormControl size="small" sx={{ minWidth: 180 }}>
              <InputLabel>Status</InputLabel>
              <Select
                label="Status"
                value={status}
                onChange={(event) =>
                  setStatus(
                    event.target.value as
                      FollowUpStatus | "ALL",
                  )
                }
              >
                {statuses.map((value) => (
                  <MenuItem key={value} value={value}>
                    {value === "ALL"
                      ? "All statuses"
                      : readable(value)}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>

            <FormControl size="small" sx={{ minWidth: 160 }}>
              <InputLabel>Priority</InputLabel>
              <Select
                label="Priority"
                value={priority}
                onChange={(event) =>
                  setPriority(
                    event.target.value as
                      FollowUpPriority | "ALL",
                  )
                }
              >
                {priorities.map((value) => (
                  <MenuItem key={value} value={value}>
                    {value === "ALL"
                      ? "All priorities"
                      : readable(value)}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>
          </Stack>

          {recordsQuery.isLoading ? (
            <Box
              sx={{
                display: "flex",
                justifyContent: "center",
                py: 6,
              }}
            >
              <CircularProgress />
            </Box>
          ) : recordsQuery.isError ? (
            <Alert severity="error">
              {getErrorMessage(recordsQuery.error)}
            </Alert>
          ) : filteredRecords.length === 0 ? (
            <Alert severity="info">
              No follow-ups match the selected filters.
            </Alert>
          ) : (
            <TableContainer>
              <Table size="small">
                <TableHead>
                  <TableRow>
                    <TableCell>Customer</TableCell>
                    <TableCell>Product</TableCell>
                    <TableCell>Branch</TableCell>
                    <TableCell>Assigned To</TableCell>
                    <TableCell>Follow-up Date</TableCell>
                    <TableCell>Priority</TableCell>
                    <TableCell>Status</TableCell>
                    <TableCell>Outcome</TableCell>
                    {canUpdate && <TableCell>Actions</TableCell>}
                  </TableRow>
                </TableHead>

                <TableBody>
                  {filteredRecords.map((item) => (
                    <TableRow hover key={item.id}>
                      <TableCell>
                        {item.customerNameMasked ||
                          item.customerReference ||
                          "N/A"}
                      </TableCell>

                      <TableCell>
                        {item.product?.name || "N/A"}
                      </TableCell>

                      <TableCell>
                        {item.branch?.name || "N/A"}
                      </TableCell>

                      <TableCell>
                        {userName(
                          item.assignedTo,
                          item.assignedToUserId,
                        )}
                      </TableCell>

                      <TableCell>
                        {displayDate(item.followUpDate)}
                      </TableCell>

                      <TableCell>
                        <Chip
                          size="small"
                          label={readable(item.priority)}
                          color={priorityColor(item.priority)}
                          variant="outlined"
                        />
                      </TableCell>

                      <TableCell>
                        <Chip
                          size="small"
                          label={readable(item.status)}
                          color={statusColor(item.status)}
                        />
                      </TableCell>

                      <TableCell>
                        {item.outcome || "N/A"}
                      </TableCell>

                      {canUpdate && (
                        <TableCell>
                          <Button
                            size="small"
                            variant="outlined"
                            startIcon={<EditOutlined />}
                            onClick={() => {
                              setSuccessMessage(null);
                              setEditingFollowUp(item);
                            }}
                          >
                            Edit
                          </Button>
                        </TableCell>
                      )}
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </TableContainer>
          )}

          {!recordsQuery.isLoading &&
            !recordsQuery.isError && (
              <Typography
                variant="caption"
                color="text.secondary"
                sx={{ display: "block", mt: 2 }}
              >
                Showing {filteredRecords.length} of{" "}
                {recordsQuery.data?.length ?? 0} follow-ups
              </Typography>
            )}
        </CardContent>
      </Card>

      {canUpdate && (
        <FollowUpEditDialog
          open={editingFollowUp !== null}
          followUp={editingFollowUp}
          onClose={() => setEditingFollowUp(null)}
          onSubmit={handleEdit}
          submitting={editMutation.isPending}
        />
      )}

      {canCreate && (
        <FollowUpCreateDialog
          open={createOpen}
          onClose={() => setCreateOpen(false)}
          onSubmit={handleCreate}
          submitting={createMutation.isPending}
        />
      )}
    </Box>
  );
}




