# ============================================
# DIGITAL PERFORMANCE MONITORING PLATFORM
# ============================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build output
dist/
**/dist/
build/
**/build/
.next/
**/.next/

# Test coverage
coverage/
**/coverage/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
.cache/
**/.cache/

# TypeScript
*.tsbuildinfo

# IDE / Editor
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Prisma generated client
apps/api/src/generated/prisma/

# Local database files
*.db
*.db-journal

# Miscellaneous
*.swp
*.swo
# Allow production environment examples
!**/.env.*.example

# Allow production environment examples

# Local runtime logs and service files
/runtime/

# Local development backups
*.bak
*.before-runtime-config.txt

# Production deployment secrets
/deployment/production/*.env
/deployment/production/*.env.*
!/deployment/production/*.env.example
!/deployment/production/*.env.*.example

/apps/api/uat-initial-credentials.json

# ==================================================
# LOCAL SENSITIVE DATA - NEVER COMMIT
# ==================================================

/private/
/backups/
/imports/

# Local credential exports
*credentials*.csv
*passwords*.csv
*credentials*.json

# Database backup files
*.sql.gz
*.dump
*.backup

# Local development and generated backup copies
*.before-*.ts
*.backup-*

# Aiven database TLS certificate (managed separately on Render)
/apps/api/certs/
